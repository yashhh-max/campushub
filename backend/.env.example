# Django Configuration
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-secure-random-string-campushub
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=False

# Database Configuration (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://campushub_user:campushub_secret@localhost:5432/campushub_db

# Redis & Channels Configuration
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS_CHANNEL_LAYER=False

# JWT Token Configuration
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# CORS Configuration (Origins permitted to make API requests)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Delivery Configuration (Console backend by default for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=CampusHub Notifications <noreply@campushub.edu>

# Allowed Student Email Domains (* for any, or e.g. state.edu,campus.edu)
ALLOWED_STUDENT_EMAIL_DOMAINS=*

