# ==============================================================================
# KPRIT CampusHub — Backend Environment Configuration Template
# For production deployment at Kommuri Pratap Reddy Institute of Technology
# ==============================================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=generate-a-cryptographically-secure-random-key-min-50-chars-for-kprit
ALLOWED_HOSTS=campushub.kprit,api.campushub.kprit,.kprit,campushub.kpritech.ac.in,api.campushub.kpritech.ac.in,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://campushub.kprit,https://campushub.kprit,http://api.campushub.kprit,https://api.campushub.kprit,https://campushub.kpritech.ac.in,https://api.campushub.kpritech.ac.in
CORS_ALLOWED_ORIGINS=http://campushub.kprit,https://campushub.kprit,http://campushub.kprit:3000,http://api.campushub.kprit,https://api.campushub.kprit,https://campushub.kpritech.ac.in

# SSL / TLS Hardening
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Production Database (PostgreSQL 15+)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://kprit_campushub_user:STRONG_PASSWORD_HERE@localhost:5432/kprit_campushub_db

# Redis & Channels Configuration (WebSocket Real-Time Engine)
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS_CHANNEL_LAYER=True

# JWT Token Security Settings
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Institutional Domain Restriction
# Restricts student registration to official KPRIT email addresses
ALLOWED_STUDENT_EMAIL_DOMAINS=kpritech.ac.in

# Institutional Email Delivery (SMTP Gateway)
# In development: django.core.mail.backends.console.EmailBackend
# In production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@kpritech.ac.in
EMAIL_HOST_PASSWORD=institutional-app-password-or-smtp-key
DEFAULT_FROM_EMAIL=KPRIT CampusHub <notifications@kpritech.ac.in>

# Logging & Monitoring
DJANGO_LOG_LEVEL=INFO
