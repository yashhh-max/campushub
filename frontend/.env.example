# ==============================================================================
# KPRIT CampusHub — Frontend Environment Configuration Template
# For production deployment at Kommuri Pratap Reddy Institute of Technology
# ==============================================================================

# Public API Gateway (Backend Django ASGI server)
NEXT_PUBLIC_API_URL=https://api.campushub.kprit

# Public WebSocket Gateway (Django Channels real-time engine)
NEXT_PUBLIC_WS_URL=wss://api.campushub.kprit

# Institutional Branding
NEXT_PUBLIC_APP_NAME=CampusHub
NEXT_PUBLIC_CAMPUS_NAME=Kommuri Pratap Reddy Institute of Technology (KPRIT)
